{
  "name": "auth-starter",
  "version": "1.0.0",
  "description": "Minimal JWT auth starter: access/refresh token rotation, reuse detection, and Argon2id hashing. Express 5 + TypeScript + PostgreSQL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file .env --watch src/index.ts",
    "start": "node --env-file .env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FK78/auth-starter.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/FK78/auth-starter/issues"
  },
  "homepage": "https://github.com/FK78/auth-starter#readme",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
